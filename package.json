{
  "name": "lopui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "ng-packagr -p packages/angular/ng-package.json -c packages/angular/tsconfig.lib.json",
    "verify": "npm run test && npm run build",
    "cli": "node packages/cli/bin/lopui.mjs"
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  }
}
